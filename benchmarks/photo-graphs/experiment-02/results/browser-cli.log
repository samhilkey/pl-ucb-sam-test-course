await (async (page) => {const sources={"star-photo.js":"/* ---------------------------------------------------------------------------\n * STAR: hand-drawn graph capture for pl-sketch.\n *\n * Ported from the Sketch to Graph prototype. This file covers the guided\n * markup path only: upload a photo, place the axes by dragging three handles,\n * trace roughly along the curve, and snap that trace onto the actual ink.\n * The result is a list of points in GRAPH coordinates.\n *\n * Everything here runs in the browser with no network and no model calls,\n * which is what lets it work inside a locked-down exam.\n *\n * Each canvas on a page gets its own instance, so nothing is shared in module\n * scope — the upstream prototype used page-wide globals and would collide if\n * a question had two sketch canvases.\n * ------------------------------------------------------------------------- */\n\nwindow.StarPhoto = (function () {\n  'use strict'\n\n  function create (options) {\n    const root = options.root // container element for the UI\n    const onConfirm = options.onConfirm || function () { return { ok: false, message: '' } }\n\n    // ---- per-instance state (was module-global in the prototype) ----\n    let photoBmp = null\n    let MW = 0\n    let MH = 0\n    let maskCache = null\n    let markup = null\n    let mode = 'axes'\n    let drag = null\n    let refined = null\n    let lastHandle = 'X'\n    let tracedPoints = null\n    let currentModel = null\n    let photoLoading = false\n    let photoRequest = 0\n\n    root.innerHTML = `\n      <div class=\"star-photo-ui\">\n        <div class=\"star-row\">\n          <label class=\"btn btn-sm btn-primary star-file-btn\">\n            Take or choose photo\n            <input type=\"file\" accept=\"image/jpeg,image/png,image/webp\" capture=\"environment\" hidden>\n          </label>\n          <button type=\"button\" class=\"btn btn-sm btn-light border star-mode-axes star-on\">1 &middot; Place the axes</button>\n          <button type=\"button\" class=\"btn btn-sm btn-light border star-mode-curve\">2 &middot; Trace the curve</button>\n          <button type=\"button\" class=\"btn btn-sm btn-light border star-undo\">Undo stroke</button>\n          <button type=\"button\" class=\"btn btn-sm btn-light border star-clear\">Clear trace</button>\n        </div>\n\n        <p class=\"star-hint text-muted\"></p>\n\n        <div class=\"star-canvas-wrap\"><canvas class=\"star-canvas\"></canvas></div>\n\n        <div class=\"star-row star-scale\">\n          <label>x-dot sits at x = <input type=\"number\" step=\"any\" value=\"1\" class=\"star-xval\"></label>\n          <label>y-dot sits at y = <input type=\"number\" step=\"any\" value=\"1\" class=\"star-yval\"></label>\n          <label><input type=\"checkbox\" class=\"star-equal\"> Same scale on both axes</label>\n          <label><input type=\"checkbox\" class=\"star-units\" checked> Show unit grid</label>\n          <label>Search width <input type=\"range\" min=\"6\" max=\"48\" value=\"16\" class=\"star-brush\"></label>\n        </div>\n\n        <p class=\"star-scale-read text-muted\"></p>\n\n        <div class=\"star-row\">\n          <button type=\"button\" class=\"btn btn-sm btn-success star-use\" disabled>Read my trace</button>\n          <span class=\"star-status text-muted\"></span>\n        </div>\n\n        <div class=\"star-fit-box\" hidden>\n          <p class=\"star-fit-eq\"></p>\n          <p class=\"star-fit-meta text-muted\"></p>\n          <div class=\"star-row\">\n            <label>\n              Curve type\n              <select class=\"star-family\">\n                <option value=\"\">Let it choose</option>\n                <option value=\"polynomial\">Polynomial</option>\n                <option value=\"sine\">Sine wave</option>\n                <option value=\"exponential\">Exponential</option>\n                <option value=\"sqrt\">Square root</option>\n                <option value=\"logarithmic\">Logarithm</option>\n                <option value=\"abs\">Absolute value</option>\n                <option value=\"rational\">Rational (1/x type)</option>\n                <option value=\"tan\">Tangent</option>\n              </select>\n            </label>\n            <label class=\"star-degree-wrap\" hidden>\n              Degree <input type=\"number\" class=\"star-degree\" min=\"1\" max=\"6\" step=\"1\" value=\"3\">\n            </label>\n            <button type=\"button\" class=\"btn btn-sm btn-light border star-refit\">Refit</button>\n            <button type=\"button\" class=\"btn btn-sm btn-success star-confirm\" disabled>This matches my sketch</button>\n          </div>\n        </div>\n\n        <pre class=\"star-result\" hidden></pre>\n      </div>\n    `\n\n    const q = (sel) => root.querySelector(sel)\n    const canvas = q('.star-canvas')\n    const statusEl = q('.star-status')\n\n    const setStatus = (text) => {\n      statusEl.textContent = text || ''\n    }\n\n    function clearFit () {\n      currentModel = null\n      q('.star-confirm').disabled = true\n      q('.star-fit-eq').textContent = ''\n      q('.star-fit-meta').textContent = ''\n      q('.star-result').textContent = ''\n      q('.star-result').hidden = true\n    }\n\n    // A fit belongs to the photo, calibration and trace it was calculated from.\n    // Keep extracted points only when changing fit settings, not those inputs.\n    function invalidateTrace () {\n      tracedPoints = null\n      refined = null\n      clearFit()\n      q('.star-fit-box').hidden = true\n      setStatus('Read your trace again to update the preview.')\n    }\n\n    // ---- photo loading -----------------------------------------------------\n    async function showPhoto (blob, request) {\n      let bitmap\n      try {\n        bitmap = await window.createImageBitmap(blob, { imageOrientation: 'from-image' })\n      } catch (e) {\n        bitmap = await window.createImageBitmap(blob)\n      }\n      // A slower, superseded upload must not replace the latest chosen photo.\n      if (request !== photoRequest) {\n        bitmap.close()\n        return\n      }\n      if (photoBmp) photoBmp.close()\n      photoBmp = bitmap\n      const sc = Math.min(1, 900 / Math.max(photoBmp.width, photoBmp.height))\n      MW = Math.round(photoBmp.width * sc)\n      MH = Math.round(photoBmp.height * sc)\n      maskCache = null\n      refined = null\n      markup = {\n        O: [MW * 0.5, MH * 0.55],\n        X: [MW * 0.75, MH * 0.55],\n        Y: [MW * 0.5, MH * 0.3],\n        strokes: []\n      }\n      setMode('axes')\n      q('.star-use').disabled = false\n      drawPhoto()\n    }\n\n    function setMode (m) {\n      mode = m\n      q('.star-mode-axes').classList.toggle('star-on', m === 'axes')\n      q('.star-mode-curve').classList.toggle('star-on', m === 'curve')\n      q('.star-hint').textContent =\n        m === 'axes'\n          ? 'Drag the three dots: O onto your origin, then x and y onto the points where they equal the numbers below. The blue grid shows the scale that implies — drag until it lines up with the paper.'\n          : 'Drag roughly along your curve. Several strokes are fine, one per branch. The tracer snaps to the ink near your line.'\n    }\n\n    // ---- drawing the photo, handles and unit grid --------------------------\n    function drawPhoto () {\n      if (!photoBmp) return\n      if (canvas.width !== MW) {\n        canvas.width = MW\n        canvas.height = MH\n      }\n      const x = canvas.getContext('2d')\n      x.clearRect(0, 0, MW, MH)\n      x.drawImage(photoBmp, 0, 0, MW, MH)\n      if (!markup) return\n\n      const O = markup.O\n      const X = markup.X\n      const Y = markup.Y\n\n      const ray = (A, B) => {\n        const dx = B[0] - A[0]\n        const dy = B[1] - A[1]\n        const L = Math.hypot(dx, dy) || 1\n        const k = (4 * Math.max(MW, MH)) / L\n        x.beginPath()\n        x.moveTo(A[0] - dx * k, A[1] - dy * k)\n        x.lineTo(A[0] + dx * k, A[1] + dy * k)\n        x.stroke()\n      }\n\n      const xv = +q('.star-xval').value || 1\n      const yv = +q('.star-yval').value || 1\n      const uxv = [(X[0] - O[0]) / xv, (X[1] - O[1]) / xv]\n      const uyv = [(Y[0] - O[0]) / yv, (Y[1] - O[1]) / yv]\n      const lux = Math.hypot(uxv[0], uxv[1])\n      const luy = Math.hypot(uyv[0], uyv[1])\n\n      if (q('.star-units').checked && lux > 3 && luy > 3) {\n        const diag = Math.hypot(MW, MH)\n        const nx = Math.min(60, Math.ceil(diag / lux))\n        const ny = Math.min(60, Math.ceil(diag / luy))\n        x.lineWidth = 1\n        for (let k = -nx; k <= nx; k++) {\n          if (!k) continue\n          const b0 = [O[0] + uxv[0] * k, O[1] + uxv[1] * k]\n          x.strokeStyle = k % 5 ? 'rgba(30,100,215,.18)' : 'rgba(30,100,215,.38)'\n          x.beginPath()\n          x.moveTo(b0[0] - (uyv[0] / luy) * diag, b0[1] - (uyv[1] / luy) * diag)\n          x.lineTo(b0[0] + (uyv[0] / luy) * diag, b0[1] + (uyv[1] / luy) * diag)\n          x.stroke()\n        }\n        for (let k = -ny; k <= ny; k++) {\n          if (!k) continue\n          const b0 = [O[0] + uyv[0] * k, O[1] + uyv[1] * k]\n          x.strokeStyle = k % 5 ? 'rgba(30,100,215,.18)' : 'rgba(30,100,215,.38)'\n          x.beginPath()\n          x.moveTo(b0[0] - (uxv[0] / lux) * diag, b0[1] - (uxv[1] / lux) * diag)\n          x.lineTo(b0[0] + (uxv[0] / lux) * diag, b0[1] + (uxv[1] / lux) * diag)\n          x.stroke()\n        }\n      }\n\n      x.lineWidth = 2.5\n      x.strokeStyle = 'rgba(214,48,32,.9)'\n      ray(O, X)\n      ray(O, Y)\n\n      // rough strokes, then the ink the tracer locked onto\n      x.strokeStyle = 'rgba(175,60,190,.32)'\n      x.lineWidth = Math.max(6, +q('.star-brush').value)\n      x.lineCap = 'round'\n      x.lineJoin = 'round'\n      markup.strokes.forEach((st) => {\n        x.beginPath()\n        st.forEach((p, i) => (i ? x.lineTo(p[0], p[1]) : x.moveTo(p[0], p[1])))\n        if (st.length === 1) x.lineTo(st[0][0] + 0.1, st[0][1])\n        x.stroke()\n      })\n      if (refined) {\n        x.strokeStyle = 'rgba(30,100,215,.95)'\n        x.lineWidth = 4\n        refined.forEach((st) => {\n          x.beginPath()\n          st.forEach((p, i) => (i ? x.lineTo(p[0], p[1]) : x.moveTo(p[0], p[1])))\n          x.stroke()\n        })\n      }\n\n      const dot = (p, r, fill, txt) => {\n        x.beginPath()\n        x.arc(p[0], p[1], r, 0, 7)\n        x.fillStyle = fill\n        x.fill()\n        x.lineWidth = 2.5\n        x.strokeStyle = '#fff'\n        x.stroke()\n        x.fillStyle = '#fff'\n        x.font = '600 13px ui-sans-serif,system-ui'\n        x.textAlign = 'center'\n        x.textBaseline = 'middle'\n        x.fillText(txt, p[0], p[1])\n      }\n      dot(X, 11, '#b0431f', 'x')\n      dot(Y, 11, '#1f6bb0', 'y')\n      dot(O, 13, '#c2452d', 'O')\n\n      const ratio = lux && luy ? lux / luy : 1\n      q('.star-scale-read').textContent =\n        `Scale: ${lux.toFixed(1)} px per x-unit, ${luy.toFixed(1)} px per y-unit` +\n        (Math.abs(ratio - 1) < 0.03 ? ' — square units.' : ' — units are not square.')\n    }\n\n    function applyEqual (from) {\n      if (!q('.star-equal').checked || !markup) return\n      const xv = +q('.star-xval').value || 1\n      const yv = +q('.star-yval').value || 1\n      const O = markup.O\n      const dx = [markup.X[0] - O[0], markup.X[1] - O[1]]\n      const dy = [markup.Y[0] - O[0], markup.Y[1] - O[1]]\n      const lx = Math.hypot(dx[0], dx[1]) / Math.abs(xv)\n      const ly = Math.hypot(dy[0], dy[1]) / Math.abs(yv)\n      if (!lx || !ly) return\n      if (from === 'X') {\n        const k = (lx * Math.abs(yv)) / Math.hypot(dy[0], dy[1])\n        markup.Y = [O[0] + dy[0] * k, O[1] + dy[1] * k]\n      } else {\n        const k = (ly * Math.abs(xv)) / Math.hypot(dx[0], dx[1])\n        markup.X = [O[0] + dx[0] * k, O[1] + dx[1] * k]\n      }\n    }\n\n    // ---- pointer handling --------------------------------------------------\n    function canvasPt (ev) {\n      const r = canvas.getBoundingClientRect()\n      return [((ev.clientX - r.left) * MW) / r.width, ((ev.clientY - r.top) * MH) / r.height]\n    }\n\n    canvas.addEventListener('pointerdown', (e) => {\n      if (!markup || photoLoading) return\n      const p = canvasPt(e)\n      canvas.setPointerCapture(e.pointerId)\n      e.preventDefault()\n      if (mode === 'axes') {\n        const near = [\n          ['O', markup.O],\n          ['X', markup.X],\n          ['Y', markup.Y]\n        ]\n          .map(([k, v]) => [k, Math.hypot(v[0] - p[0], v[1] - p[1])])\n          .sort((a, b) => a[1] - b[1])[0]\n        drag = near[1] < Math.max(26, MW * 0.04) ? { kind: 'handle', key: near[0] } : null\n        if (drag) {\n          invalidateTrace()\n          markup[drag.key] = p\n          if (drag.key !== 'O') applyEqual(drag.key)\n          lastHandle = drag.key\n          drawPhoto()\n        }\n      } else {\n        invalidateTrace()\n        drag = { kind: 'stroke' }\n        markup.strokes.push([p])\n        drawPhoto()\n      }\n    })\n\n    canvas.addEventListener('pointermove', (e) => {\n      if (!drag || photoLoading) return\n      const p = canvasPt(e)\n      e.preventDefault()\n      invalidateTrace()\n      if (drag.kind === 'handle') {\n        markup[drag.key] = p\n        if (drag.key !== 'O') applyEqual(drag.key)\n      } else {\n        const st = markup.strokes[markup.strokes.length - 1]\n        const last = st[st.length - 1]\n        if (Math.hypot(p[0] - last[0], p[1] - last[1]) > 2) st.push(p)\n      }\n      drawPhoto()\n    })\n\n    const endDrag = () => {\n      if (drag && drag.kind === 'stroke') {\n        const st = markup.strokes[markup.strokes.length - 1]\n        if (st.length < 3) markup.strokes.pop()\n      }\n      drag = null\n      drawPhoto()\n    }\n    canvas.addEventListener('pointerup', endDrag)\n    canvas.addEventListener('pointercancel', endDrag)\n\n    // ---- ink detection -----------------------------------------------------\n    // Adaptive threshold: a pixel counts as ink when it is meaningfully darker\n    // than the average of its neighbourhood. That handles uneven lighting and\n    // shadows across a photographed page, which a fixed threshold does not.\n    function buildMask () {\n      if (maskCache) return maskCache\n      const c = document.createElement('canvas')\n      c.width = MW\n      c.height = MH\n      const cx = c.getContext('2d', { willReadFrequently: true })\n      cx.fillStyle = '#fff'\n      cx.fillRect(0, 0, MW, MH)\n      cx.drawImage(photoBmp, 0, 0, MW, MH)\n      const d = cx.getImageData(0, 0, MW, MH).data\n      const v = new Float32Array(MW * MH)\n      for (let i = 0; i < MW * MH; i++) {\n        const r = d[i * 4]\n        const g = d[i * 4 + 1]\n        const b = d[i * 4 + 2]\n        const mx = Math.max(r, g, b)\n        const mn = Math.min(r, g, b)\n        v[i] = 0.299 * r + 0.587 * g + 0.114 * b + 0.6 * (mx - mn)\n      }\n      const I = new Float64Array((MW + 1) * (MH + 1))\n      for (let y = 0; y < MH; y++) {\n        let rs = 0\n        for (let x = 0; x < MW; x++) {\n          rs += v[y * MW + x]\n          I[(y + 1) * (MW + 1) + x + 1] = I[y * (MW + 1) + x + 1] + rs\n        }\n      }\n      const R = Math.max(8, Math.round(Math.max(MW, MH) / 40))\n      const dk = new Uint8Array(MW * MH)\n      for (let y = 0; y < MH; y++) {\n        const y0 = Math.max(0, y - R)\n        const y1 = Math.min(MH, y + R + 1)\n        for (let x = 0; x < MW; x++) {\n          const x0 = Math.max(0, x - R)\n          const x1 = Math.min(MW, x + R + 1)\n          const m =\n            (I[y1 * (MW + 1) + x1] - I[y0 * (MW + 1) + x1] - I[y1 * (MW + 1) + x0] + I[y0 * (MW + 1) + x0]) /\n            ((y1 - y0) * (x1 - x0))\n          if (v[y * MW + x] < m - 20) dk[y * MW + x] = 1\n        }\n      }\n      maskCache = { dark: dk }\n      return maskCache\n    }\n\n    // Walk along the rough stroke; at each step look sideways (perpendicular to\n    // the direction of travel) for ink, and move the point onto it. Runs that\n    // sit on the axis lines are ignored so the trace does not get captured by\n    // them where the curve crosses.\n    function snapStroke (st, R) {\n      const dark = buildMask().dark\n      const D = (x, y) => {\n        x = Math.round(x)\n        y = Math.round(y)\n        return x >= 0 && y >= 0 && x < MW && y < MH && dark[y * MW + x]\n      }\n      const O = markup.O\n      const X = markup.X\n      const Y = markup.Y\n      const distLine = (p, A, B) => {\n        const dx = B[0] - A[0]\n        const dy = B[1] - A[1]\n        const L = Math.hypot(dx, dy) || 1\n        return Math.abs((p[0] - A[0]) * dy - (p[1] - A[1]) * dx) / L\n      }\n      const onAxis = (p) => distLine(p, O, X) < 4 || distLine(p, O, Y) < 4\n\n      const path = []\n      for (let i = 1; i < st.length; i++) {\n        const a = st[i - 1]\n        const b = st[i]\n        const L = Math.hypot(b[0] - a[0], b[1] - a[1])\n        const n = Math.max(1, Math.round(L / 2))\n        for (let k = 0; k < n; k++) {\n          path.push([a[0] + ((b[0] - a[0]) * k) / n, a[1] + ((b[1] - a[1]) * k) / n])\n        }\n      }\n      path.push(st[st.length - 1])\n\n      const out = []\n      let prevOff = 0\n      let hits = 0\n      path.forEach((p, i) => {\n        const a = path[Math.max(0, i - 3)]\n        const b = path[Math.min(path.length - 1, i + 3)]\n        let tx = b[0] - a[0]\n        let ty = b[1] - a[1]\n        const L = Math.hypot(tx, ty) || 1\n        tx /= L\n        ty /= L\n        const nx = -ty\n        const ny = tx\n        const runs = []\n        let s0 = null\n        for (let k = -R; k <= R; k++) {\n          const pt = [p[0] + nx * k, p[1] + ny * k]\n          const on = D(pt[0], pt[1]) && !onAxis(pt)\n          if (on && s0 === null) s0 = k\n          if ((!on || k === R) && s0 !== null) {\n            runs.push([(s0 + (on ? k : k - 1)) / 2, (on ? k : k - 1) - s0 + 1])\n            s0 = null\n          }\n        }\n        const good = runs.filter((r) => r[1] <= Math.max(6, R * 0.8))\n        const pick = (good.length ? good : runs).sort(\n          (A, B) =>\n            Math.abs(A[0]) + Math.abs(A[0] - prevOff) * 0.8 - (Math.abs(B[0]) + Math.abs(B[0] - prevOff) * 0.8)\n        )[0]\n        if (pick) {\n          prevOff = 0.5 * prevOff + 0.5 * pick[0]\n          hits++\n          out.push([p[0] + nx * pick[0], p[1] + ny * pick[0]])\n        } else {\n          out.push([p[0], p[1]])\n        }\n      })\n\n      const sm = out.map((p, i) => {\n        let sx = 0\n        let sy = 0\n        let n = 0\n        for (let k = Math.max(0, i - 2); k <= Math.min(out.length - 1, i + 2); k++) {\n          sx += out[k][0]\n          sy += out[k][1]\n          n++\n        }\n        return [sx / n, sy / n]\n      })\n      return { pts: sm, snapped: hits / Math.max(1, path.length) }\n    }\n\n    // ---- pixels to graph coordinates ---------------------------------------\n    // The three handles define an affine frame. Inverting it maps any pixel to\n    // graph coordinates, which also means a photo taken at a slight angle still\n    // reads correctly: the axes need not be perpendicular on the page.\n    function markupToGraph () {\n      const O = markup.O\n      const X = markup.X\n      const Y = markup.Y\n      const ux = +q('.star-xval').value || 1\n      const uy = +q('.star-yval').value || 1\n      const R = Math.round(+q('.star-brush').value)\n      const ax = [X[0] - O[0], X[1] - O[1]]\n      const ay = [Y[0] - O[0], Y[1] - O[1]]\n      const det = ax[0] * ay[1] - ax[1] * ay[0]\n      if (!det) throw new Error('The three axis dots are in a straight line — move them apart.')\n\n      const toData = (p) => {\n        const dx = p[0] - O[0]\n        const dy = p[1] - O[1]\n        return [((dx * ay[1] - dy * ay[0]) / det) * ux, ((ax[0] * dy - ax[1] * dx) / det) * uy]\n      }\n\n      refined = []\n      const curves = []\n      let snap = 0\n      let n = 0\n      markup.strokes.forEach((st) => {\n        if (st.length < 3) return\n        const r = snapStroke(st, R)\n        refined.push(r.pts)\n        snap += r.snapped\n        n++\n        // Collapse to one y per x, since pl-sketch treats a curve as a function.\n        const seen = new Map()\n        r.pts.map(toData).forEach(([x, y]) => {\n          const k = Math.round(x * 200) / 200\n          const e = seen.get(k)\n          if (e) {\n            e[0] += y\n            e[1]++\n          } else {\n            seen.set(k, [y, 1])\n          }\n        })\n        const pts = [...seen.entries()]\n          .sort((a, b) => a[0] - b[0])\n          .map(([x, [sy, c]]) => [Math.round(x * 100) / 100, Math.round((sy / c) * 100) / 100])\n        const step = Math.max(1, Math.floor(pts.length / 60))\n        const out = []\n        for (let i = 0; i < pts.length; i += step) out.push(pts[i])\n        if (pts.length) out.push(pts[pts.length - 1])\n        if (out.length > 2) curves.push({ points: out })\n      })\n\n      if (!curves.length) throw new Error('No usable trace. Switch to \"Trace the curve\" and drag along your line.')\n\n      const frac = snap / Math.max(1, n)\n      drawPhoto()\n      return { curves, snapFraction: frac, xUnit: ux, yUnit: uy }\n    }\n\n    // ---- wiring ------------------------------------------------------------\n    q('.star-file-btn input').addEventListener('change', async (e) => {\n      const f = e.target.files && e.target.files[0]\n      if (!f) return\n      const request = ++photoRequest\n      photoLoading = true\n      drag = null\n      invalidateTrace()\n      q('.star-use').disabled = true\n      setStatus('Loading photo…')\n      try {\n        await showPhoto(f, request)\n        if (request !== photoRequest) return\n        photoLoading = false\n        setStatus('Place the axes, then trace your curve.')\n      } catch (err) {\n        if (request !== photoRequest) return\n        photoLoading = false\n        q('.star-use').disabled = true\n        setStatus('Could not read that image.')\n      }\n    })\n\n    q('.star-mode-axes').addEventListener('click', () => setMode('axes'))\n    q('.star-mode-curve').addEventListener('click', () => setMode('curve'))\n    q('.star-undo').addEventListener('click', () => {\n      if (markup && markup.strokes.length) {\n        markup.strokes.pop()\n        invalidateTrace()\n        drawPhoto()\n      }\n    })\n    q('.star-clear').addEventListener('click', () => {\n      if (markup) {\n        markup.strokes = []\n        invalidateTrace()\n        drawPhoto()\n      }\n    })\n    q('.star-brush').addEventListener('input', () => {\n      invalidateTrace()\n      drawPhoto()\n    })\n    q('.star-units').addEventListener('change', drawPhoto)\n    q('.star-xval').addEventListener('input', () => {\n      invalidateTrace()\n      applyEqual('X')\n      drawPhoto()\n    })\n    q('.star-yval').addEventListener('input', () => {\n      invalidateTrace()\n      applyEqual('Y')\n      drawPhoto()\n    })\n    q('.star-equal').addEventListener('change', () => {\n      invalidateTrace()\n      applyEqual(lastHandle === 'Y' ? 'Y' : 'X')\n      drawPhoto()\n    })\n\n    // ---- fitting ------------------------------------------------------------\n    function runFit (spec) {\n      clearFit()\n      if (!tracedPoints || photoLoading) return\n      try {\n        const model = window.StarFit.fit(tracedPoints, spec)\n        if (!model) throw new Error('Could not fit a curve to that trace.')\n\n        q('.star-fit-box').hidden = false\n        q('.star-fit-eq').textContent = model.expr\n        q('.star-fit-meta').textContent =\n          `${model.label} · within ${model.rmse.toFixed(3)} units of your drawing on average` +\n          (model.poles && model.poles.length\n            ? ` · vertical asymptote${model.poles.length > 1 ? 's' : ''} at ` +\n              model.poles.map((p) => p.toFixed(2)).join(', ')\n            : '')\n\n        // Keep the dropdown in step when the fitter chose for us.\n        if (!spec || !spec.family) q('.star-family').value = model.family\n        const isPoly = model.family === 'polynomial'\n        q('.star-degree-wrap').hidden = !isPoly\n        if (isPoly && model.degree) q('.star-degree').value = model.degree\n\n        const out = q('.star-result')\n        out.hidden = false\n        out.textContent =\n          'pl-sketch function:  ' + window.StarFit.toPlFunction(model.expr) + '\\n' +\n          'domain:              ' + model.lo.toFixed(3) + ' to ' + model.hi.toFixed(3) + '\\n\\n' +\n          'sampled curve (' + window.StarFit.sampleCurve(model).length + ' points):\\n' +\n          window.StarFit.sampleCurve(model).map((p) => `(${p[0]}, ${p[1]})`).join('  ')\n        currentModel = model\n        q('.star-confirm').disabled = false\n      } catch (err) {\n        clearFit()\n        setStatus(err.message || 'Could not fit a curve to that trace.')\n      }\n    }\n\n    // The student confirms the curve is a fair transcription of what they drew.\n    // Only at that point does anything reach the canvas.\n    q('.star-confirm').addEventListener('click', () => {\n      if (!currentModel || photoLoading || q('.star-confirm').disabled) return\n      const res = onConfirm(currentModel)\n      setStatus(res && res.message ? res.message : '')\n    })\n\n    q('.star-use').addEventListener('click', () => {\n      if (!markup || photoLoading || q('.star-use').disabled) return\n      invalidateTrace()\n      try {\n        const result = markupToGraph()\n        tracedPoints = result.curves[0].points\n        const pct = Math.round(result.snapFraction * 100)\n        setStatus(\n          pct > 80\n            ? `Snapped to ink along ${pct}% of your trace.`\n            : `Only ${pct}% of your trace found ink. Widen the search width or trace closer to the curve.`\n        )\n        runFit(null) // let the fitter choose the family\n      } catch (err) {\n        setStatus(err.message || 'Could not read the markup.')\n      }\n    })\n\n    // Structured correction: the student overrides the family rather than\n    // describing the problem in words. Same constraint objects the prototype\n    // produced, without needing anything to interpret English.\n    q('.star-family').addEventListener('change', () => {\n      const fam = q('.star-family').value\n      q('.star-degree-wrap').hidden = fam !== 'polynomial'\n      runFit(fam ? { family: fam, degree: +q('.star-degree').value || 3, constraints: [], traceWeight: 1 } : null)\n    })\n    q('.star-refit').addEventListener('click', () => {\n      const fam = q('.star-family').value\n      runFit(fam ? { family: fam, degree: +q('.star-degree').value || 3, constraints: [], traceWeight: 1 } : null)\n    })\n    q('.star-degree').addEventListener('input', () => {\n      clearFit()\n      setStatus('Fit settings changed. Refit to update the preview.')\n    })\n\n    setMode('axes')\n    return { drawPhoto }\n  }\n\n  return { create }\n})()\n","star-fit.js":"/* ---------------------------------------------------------------------------\n * STAR: fitting a transformed parent function to traced points.\n *\n * Ported from the Sketch to Graph prototype. Pure math, no network, no model.\n *\n * Two ideas carry the whole thing:\n *\n *  1. Each family is linear in its coefficients once its one non-linear\n *     parameter is fixed (the period of a sine, the pole of a rational, the\n *     shift of a log). So we grid-search that parameter and solve least\n *     squares for the rest at each step. Cheap, and no optimiser needed.\n *\n *  2. Choosing between families is not \"lowest error wins\". A degree-10\n *     polynomial can thread any hand-drawn wobble, and that is exactly the\n *     failure we do not want. Each family carries a cost in how unlikely a\n *     student is to have drawn it, and among fits that are close enough, the\n *     cheapest one wins.\n * ------------------------------------------------------------------------- */\n\n(function (root) {\n  'use strict';\n\n  // Weighted least squares by Gauss-Jordan on the normal equations, with a\n  // small ridge term so a near-singular basis does not blow up.\n  function solveLS(rows, rhs, w) {\n    const n = rows[0].length;\n    const A = Array.from({ length: n }, () => new Float64Array(n + 1));\n    rows.forEach((r, i) => {\n      const ww = w[i] * w[i];\n      for (let a = 0; a < n; a++) {\n        if (!r[a]) continue;\n        for (let b = 0; b < n; b++) A[a][b] += ww * r[a] * r[b];\n        A[a][n] += ww * r[a] * rhs[i];\n      }\n    });\n    let tr = 0;\n    for (let a = 0; a < n; a++) tr += A[a][a];\n    for (let a = 0; a < n; a++) A[a][a] += 1e-11 * tr + 1e-14;\n    for (let c = 0; c < n; c++) {\n      let pv = c;\n      for (let r = c + 1; r < n; r++) if (Math.abs(A[r][c]) > Math.abs(A[pv][c])) pv = r;\n      const tmp = A[c];\n      A[c] = A[pv];\n      A[pv] = tmp;\n      const d = A[c][c] || 1e-14;\n      for (let r = 0; r < n; r++) {\n        if (r === c) continue;\n        const f = A[r][c] / d;\n        if (f) for (let k = c; k <= n; k++) A[r][k] -= f * A[c][k];\n      }\n    }\n    return A.map((r, i) => r[n] / (r[i] || 1e-14));\n  }\n\n  const g3 = (v) => {\n    if (!isFinite(v)) return '0';\n    const a = Math.abs(v);\n    return a >= 1000 || (a < 0.001 && a > 0) ? v.toPrecision(3) : String(+v.toPrecision(4));\n  };\n\n  // Cost = how unlikely a student is to have drawn it, in parameter-equivalents.\n  const FAMS = {\n    polynomial: { cost: (d) => (d <= 3 ? d : d === 4 ? 5 : d === 5 ? 6.5 : 8.5) },\n    sine: { cost: () => 3.5 },\n    exponential: { cost: () => 4 },\n    sqrt: { cost: () => 4.5 },\n    logarithmic: { cost: () => 4.5 },\n    abs: { cost: () => 4.5 },\n    rational: { cost: () => 5.5 },\n    tan: { cost: () => 6.5 },\n  };\n  const FAM_LABEL = {\n    polynomial: 'polynomial',\n    sine: 'sine wave',\n    exponential: 'exponential',\n    sqrt: 'square root',\n    logarithmic: 'logarithm',\n    abs: 'absolute value',\n    rational: 'rational (1/x type)',\n    tan: 'tangent',\n  };\n\n  function fitModel(spec, pts) {\n    const xs = pts.map((p) => p[0]);\n    let lo = Math.min.apply(null, xs);\n    let hi = Math.max.apply(null, xs);\n    if (\n      Array.isArray(spec.domain) &&\n      spec.domain.length === 2 &&\n      spec.domain.every(Number.isFinite) &&\n      spec.domain[1] > spec.domain[0]\n    ) {\n      lo = spec.domain[0];\n      hi = spec.domain[1];\n    }\n    const span = hi - lo || 1;\n    const ys = pts.map((p) => p[1]);\n    const yspan = Math.max.apply(null, ys) - Math.min.apply(null, ys) || 1;\n    const tw = Math.max(0.02, Math.min(1, spec.traceWeight == null ? 1 : spec.traceWeight));\n    const cons = (spec.constraints || []).filter((c) => Number.isFinite(c.x));\n    const wc = 60 * Math.sqrt(pts.length); // constraints outweigh the trace\n    const BIG = 1e6;\n\n    // B: basis functions, D1/D2: their derivatives (so a slope or inflection\n    // constraint is just another linear row), valid: domain guard.\n    const lsq = (B, D1, D2, valid) => {\n      const rows = [];\n      const rhs = [];\n      const w = [];\n      const ok = (x) => (!valid || valid(x)) && B(x).every(Number.isFinite);\n      pts.forEach((p) => {\n        if (!ok(p[0])) return;\n        rows.push(B(p[0]));\n        rhs.push(p[1]);\n        w.push(tw);\n      });\n      if (rows.length < 2) return null;\n      cons.forEach((c) => {\n        if (!ok(c.x)) return;\n        if (c.type === 'point' && Number.isFinite(c.y)) {\n          rows.push(B(c.x));\n          rhs.push(c.y);\n          w.push(wc);\n        } else if (c.type === 'slope' && Number.isFinite(c.slope)) {\n          rows.push(D1(c.x));\n          rhs.push(c.slope);\n          w.push(wc);\n        } else if (c.type === 'inflection') {\n          rows.push(D2(c.x));\n          rhs.push(0);\n          w.push(wc);\n        }\n      });\n      const coef = solveLS(rows, rhs, w);\n      if (coef.some((q) => !Number.isFinite(q))) return null;\n      const f = (x) => {\n        if (valid && !valid(x)) return NaN;\n        const v = B(x).reduce((a, b, k) => a + b * coef[k], 0);\n        return Math.abs(v) > BIG ? NaN : v;\n      };\n      let se = 0;\n      let n = 0;\n      pts.forEach((p) => {\n        const v = f(p[0]);\n        if (Number.isFinite(v)) {\n          se += (v - p[1]) * (v - p[1]);\n          n++;\n        }\n      });\n      // A model that cannot cover most of the drawing does not count.\n      if (n < Math.max(4, pts.length * 0.45)) return null;\n      const rmse = Math.sqrt(se / n);\n      const cerr = cons.reduce(\n        (a, c) => a + (c.type === 'point' && Number.isFinite(f(c.x)) ? Math.abs(f(c.x) - c.y) : 0),\n        0,\n      );\n      return { coef: coef, f: f, rmse: rmse, cerr: cerr, valid: valid || (() => true) };\n    };\n\n    const score = (m) => m.rmse + m.cerr;\n    const search = (grid, mk) => {\n      let best = null;\n      grid.forEach((nl) => {\n        const m = mk(nl);\n        if (m && (!best || score(m) < score(best))) best = Object.assign({}, m, { nl: nl });\n      });\n      return best;\n    };\n    // Coarse grid, then zoom: an asymptote at 1.5 should not be reported as 1.56.\n    const search1 = (vals, mk, fixed) => {\n      fixed = fixed || [];\n      let best = null;\n      let bi = 0;\n      vals.forEach((v, i) => {\n        const m = mk([v].concat(fixed));\n        if (m && (!best || score(m) < score(best))) {\n          best = Object.assign({}, m, { nl: [v].concat(fixed) });\n          bi = i;\n        }\n      });\n      if (!best) return null;\n      let a = vals[Math.max(0, bi - 1)];\n      let b = vals[Math.min(vals.length - 1, bi + 1)];\n      for (let pass = 0; pass < 3; pass++) {\n        let bv = best.nl[0];\n        for (let k = 0; k <= 12; k++) {\n          const v = a + ((b - a) * k) / 12;\n          const m = mk([v].concat(fixed));\n          if (m && score(m) < score(best)) {\n            best = Object.assign({}, m, { nl: [v].concat(fixed) });\n            bv = v;\n          }\n        }\n        const step = (b - a) / 12;\n        a = bv - step;\n        b = bv + step;\n      }\n      return best;\n    };\n    const lin = (a, b) => Array.from({ length: 41 }, (_, k) => a + ((b - a) * k) / 40);\n\n    let r = null;\n    let fam = spec.family || 'polynomial';\n    let extra = {};\n\n    if (fam === 'sine' || fam === 'tan') {\n      const periods =\n        Number.isFinite(spec.period) && spec.period > 0\n          ? [spec.period]\n          : Array.from({ length: 60 }, (_, k) => (span / 8) * Math.pow(24, k / 59));\n      const grid = [];\n      periods.forEach((P) => {\n        if (fam === 'sine') grid.push([P, 0]);\n        else for (let k = 0; k < 16; k++) grid.push([P, lo + (P * k) / 16]);\n      });\n      const mkTrig = (nl) => {\n        const P = nl[0];\n        const sh = nl[1];\n        const b = (Math.PI * (fam === 'sine' ? 2 : 1)) / P;\n        if (fam === 'sine') {\n          return lsq(\n            (x) => [Math.sin(b * x), Math.cos(b * x), 1],\n            (x) => [b * Math.cos(b * x), -b * Math.sin(b * x), 0],\n            (x) => [-b * b * Math.sin(b * x), -b * b * Math.cos(b * x), 0],\n          );\n        }\n        const u = (x) => b * (x - sh);\n        const okx = (x) => Math.abs(Math.cos(u(x))) > 0.18;\n        return lsq(\n          (x) => [Math.tan(u(x)), 1],\n          (x) => [b / Math.pow(Math.cos(u(x)), 2), 0],\n          (x) => [(2 * b * b * Math.tan(u(x))) / Math.pow(Math.cos(u(x)), 2), 0],\n          okx,\n        );\n      };\n      r = search(grid, mkTrig);\n      if (r && periods.length > 1) {\n        const around = periods.filter((P) => P > r.nl[0] / 2 && P < r.nl[0] * 2);\n        const rr = search1(around.length > 2 ? around : periods, mkTrig, [r.nl[1]]);\n        if (rr && rr.rmse + rr.cerr < r.rmse + r.cerr) r = rr;\n      }\n      if (r) {\n        const P = r.nl[0];\n        const sh = r.nl[1];\n        const b = (Math.PI * (fam === 'sine' ? 2 : 1)) / P;\n        if (fam === 'sine') {\n          const pp = r.coef[0];\n          const qq = r.coef[1];\n          const dd = r.coef[2];\n          const A = Math.hypot(pp, qq);\n          const ph = Math.atan2(qq, pp);\n          extra = {\n            period: P,\n            expr: `y = ${g3(A)}sin(${g3(b)}x ${ph < 0 ? '-' : '+'} ${g3(Math.abs(ph))}) ${dd < 0 ? '-' : '+'} ${g3(Math.abs(dd))}`,\n            poles: [],\n          };\n        } else {\n          const poles = [];\n          for (\n            let k = Math.floor((b * (lo - sh) - Math.PI / 2) / Math.PI) - 1;\n            k <= Math.ceil((b * (hi - sh) + Math.PI / 2) / Math.PI) + 1;\n            k++\n          ) {\n            const xp = sh + (Math.PI / 2 + k * Math.PI) / b;\n            if (xp > lo && xp < hi) poles.push(xp);\n          }\n          extra = {\n            period: P,\n            shift: sh,\n            expr: `y = ${g3(r.coef[0])}tan(${g3(b)}(x ${sh < 0 ? '+' : '-'} ${g3(Math.abs(sh))})) ${r.coef[1] < 0 ? '-' : '+'} ${g3(Math.abs(r.coef[1]))}`,\n            poles: poles,\n          };\n        }\n      }\n    } else if (fam === 'exponential') {\n      const ks =\n        Number.isFinite(spec.rate) && spec.rate !== 0\n          ? [spec.rate]\n          : lin(-6 / span, 6 / span).filter((k) => Math.abs(k) > 0.15 / span);\n      r = search1(ks, (nl) => {\n        const k = nl[0];\n        return lsq(\n          (x) => [Math.exp(k * (x - lo)), 1],\n          (x) => [k * Math.exp(k * (x - lo)), 0],\n          (x) => [k * k * Math.exp(k * (x - lo)), 0],\n        );\n      });\n      if (r) {\n        const k = r.nl[0];\n        const A = r.coef[0] * Math.exp(-k * lo);\n        extra = {\n          rate: k,\n          expr: `y = ${g3(A)}e^(${g3(k)}x) ${r.coef[1] < 0 ? '-' : '+'} ${g3(Math.abs(r.coef[1]))}`,\n          poles: [],\n          asymY: r.coef[1],\n        };\n      }\n    } else if (fam === 'logarithmic' || fam === 'sqrt') {\n      const ps = Number.isFinite(spec.shift)\n        ? [spec.shift]\n        : Array.from({ length: 36 }, (_, k) => lo - span * 0.01 * Math.pow(300, k / 35));\n      const sq = fam === 'sqrt';\n      r = search1(ps, (nl) => {\n        const q = nl[0];\n        return lsq(\n          (x) => [sq ? Math.sqrt(x - q) : Math.log(x - q), 1],\n          (x) => [sq ? 0.5 / Math.sqrt(x - q) : 1 / (x - q), 0],\n          (x) => [sq ? -0.25 / Math.pow(x - q, 1.5) : -1 / ((x - q) * (x - q)), 0],\n          (x) => x - q > span * 0.002,\n        );\n      });\n      if (r) {\n        const q = r.nl[0];\n        const sgn = q < 0 ? '+' : '-';\n        extra = {\n          shift: q,\n          expr: `y = ${g3(r.coef[0])}${sq ? '√' : 'ln'}(x ${sgn} ${g3(Math.abs(q))}) ${r.coef[1] < 0 ? '-' : '+'} ${g3(Math.abs(r.coef[1]))}`,\n          poles: [],\n          domainFrom: q,\n        };\n      }\n    } else if (fam === 'rational') {\n      const ps = Number.isFinite(spec.shift) ? [spec.shift] : lin(lo - span * 0.3, hi + span * 0.3);\n      r = search1(ps, (nl) => {\n        const q = nl[0];\n        return lsq(\n          (x) => [1 / (x - q), 1],\n          (x) => [-1 / ((x - q) * (x - q)), 0],\n          (x) => [2 / Math.pow(x - q, 3), 0],\n          (x) => Math.abs(x - q) > span * 0.02,\n        );\n      });\n      if (r) {\n        const q = r.nl[0];\n        const sgn = q < 0 ? '+' : '-';\n        extra = {\n          shift: q,\n          expr: `y = ${g3(r.coef[0])}/(x ${sgn} ${g3(Math.abs(q))}) ${r.coef[1] < 0 ? '-' : '+'} ${g3(Math.abs(r.coef[1]))}`,\n          poles: q > lo && q < hi ? [q] : [],\n          asymY: r.coef[1],\n        };\n      }\n    } else if (fam === 'abs') {\n      const ps = Number.isFinite(spec.shift) ? [spec.shift] : lin(lo, hi);\n      r = search1(ps, (nl) => {\n        const q = nl[0];\n        return lsq(\n          (x) => [Math.abs(x - q), 1],\n          (x) => [Math.sign(x - q), 0],\n          () => [0, 0],\n        );\n      });\n      if (r) {\n        const q = r.nl[0];\n        const sgn = q < 0 ? '+' : '-';\n        extra = {\n          shift: q,\n          expr: `y = ${g3(r.coef[0])}|x ${sgn} ${g3(Math.abs(q))}| ${r.coef[1] < 0 ? '-' : '+'} ${g3(Math.abs(r.coef[1]))}`,\n          poles: [],\n        };\n      }\n    }\n\n    if (!r) {\n      // Polynomial, and the fallback when a named family could not be fitted.\n      fam = 'polynomial';\n      const deg = Math.max(1, Math.min(6, Math.round(spec.degree == null ? 3 : spec.degree)));\n      // Scale x before taking powers, or x^6 overflows the solver on a wide domain.\n      const s = Math.max.apply(null, [1e-9].concat(xs.map(Math.abs), [Math.abs(lo), Math.abs(hi)]));\n      r = lsq(\n        (x) => Array.from({ length: deg + 1 }, (_, k) => Math.pow(x / s, k)),\n        (x) => Array.from({ length: deg + 1 }, (_, k) => (k ? (k * Math.pow(x / s, k - 1)) / s : 0)),\n        (x) => Array.from({ length: deg + 1 }, (_, k) => (k > 1 ? (k * (k - 1) * Math.pow(x / s, k - 2)) / (s * s) : 0)),\n      );\n      if (!r) return null;\n      const a = r.coef.map((c, k) => c / Math.pow(s, k));\n      const mx = Math.max.apply(null, a.map(Math.abs)) || 1;\n      const terms = [];\n      for (let k = deg; k >= 0; k--) {\n        if (Math.abs(a[k]) < mx * 1e-6) continue;\n        const sg = a[k] < 0 ? '-' : '+';\n        const m = g3(Math.abs(a[k]));\n        terms.push({ sg: sg, t: (k === 0 ? m : m === '1' ? '' : m) + (k === 0 ? '' : k === 1 ? 'x' : 'x^' + k) });\n      }\n      extra = {\n        degree: deg,\n        expr: 'y = ' + (terms.length ? terms.map((t, i) => (i ? ` ${t.sg} ` : t.sg === '-' ? '-' : '') + t.t).join('') : '0'),\n        poles: [],\n      };\n    }\n\n    const out = Object.assign({}, r, extra, {\n      family: fam,\n      lo: lo,\n      hi: hi,\n      span: span,\n      yspan: yspan,\n      label: FAM_LABEL[fam],\n      cost: FAMS[fam].cost(extra.degree == null ? 3 : extra.degree),\n    });\n    if (!out.poles) out.poles = [];\n    return out;\n  }\n\n  // Pick the simplest believable curve: a near-perfect degree-10 loses to a\n  // close-enough cubic.\n  function autoSpec(pts) {\n    const n = pts.length;\n    const ys = pts.map((p) => p[1]);\n    const span = Math.max.apply(null, ys) - Math.min.apply(null, ys) || 1;\n    const cands = [];\n    for (let d = 1; d <= Math.min(6, Math.max(1, n - 4)); d++) {\n      cands.push({ family: 'polynomial', degree: d, constraints: [], traceWeight: 1 });\n    }\n    ['sine', 'exponential', 'sqrt', 'logarithmic', 'abs', 'rational', 'tan'].forEach((f) => {\n      if (n > 10) cands.push({ family: f, constraints: [], traceWeight: 1 });\n    });\n    const fits = cands\n      .map((sp) => {\n        let m = null;\n        try {\n          m = fitModel(sp, pts);\n        } catch (e) {\n          m = null;\n        }\n        return m ? { sp: sp, rmse: m.rmse, cost: m.cost } : null;\n      })\n      .filter(Boolean);\n    if (!fits.length) return { family: 'polynomial', degree: 3, constraints: [], traceWeight: 1 };\n    const best = Math.min.apply(null, fits.map((q) => q.rmse));\n    // How shaky is the hand-drawn line itself? No model should be asked to beat that.\n    const srt = pts.slice().sort((a, b) => a[0] - b[0]);\n    const dd = [];\n    for (let i = 1; i < srt.length - 1; i++) {\n      const v = Math.abs(srt[i][1] - (srt[i - 1][1] + srt[i + 1][1]) / 2);\n      if (Number.isFinite(v)) dd.push(v);\n    }\n    dd.sort((a, b) => a - b);\n    const noise = dd.length ? dd[Math.floor(dd.length / 2)] * 1.2 : 0;\n    const tol = Math.max(best * 1.3, noise * 1.3, best + span * 0.002);\n    const ok = fits.filter((q) => q.rmse <= tol);\n    ok.sort((a, b) => a.cost - b.cost || a.rmse - b.rmse);\n    return ok[0].sp;\n  }\n\n  function fit(pts, spec) {\n    const chosen = spec || autoSpec(pts);\n    const model = fitModel(chosen, pts);\n    if (!model) return null;\n    model.spec = chosen;\n    return model;\n  }\n\n  /* --- pl-sketch interop ------------------------------------------------- */\n\n  // pl-sketch's `function` attribute wants a Python expression in x, limited to\n  // + - * / **, parentheses, e and pi, and a fixed list of calls. Our equation\n  // strings are in human notation, so translate.\n  function toPlFunction(equation) {\n    let s = String(equation).trim();\n    s = s.replace(/^\\s*y\\s*=\\s*/, '');\n    s = s.replace(/√/g, 'sqrt');\n    s = s.replace(/(?<![A-Za-z])ln\\s*\\(/g, 'log(');\n    let guard = 0;\n    while (s.indexOf('|') !== -1 && guard++ < 20) {\n      s = s.replace(/\\|([^|]*)\\|/, 'abs($1)');\n    }\n    s = s.replace(/\\^/g, '**');\n    s = s.replace(/(\\d)\\s*([A-Za-z(])/g, '$1*$2');\n    s = s.replace(/(\\))\\s*([A-Za-z0-9(])/g, '$1*$2');\n    s = s.replace(/\\bx\\s*\\(/g, 'x*(');\n    s = s.replace(/\\*\\*\\*/g, '**');\n    return s.replace(/\\s+/g, ' ').trim();\n  }\n\n  // pl-sketch draws a function as one continuous line, so a curve with poles\n  // has to be handed over as several intervals.\n  function splitDomainAtPoles(lo, hi, poles, gap) {\n    gap = gap || 1e-3;\n    const cuts = (poles || []).filter((p) => p > lo && p < hi).sort((a, b) => a - b);\n    const spans = [];\n    let start = lo;\n    cuts.forEach((p) => {\n      spans.push([start, p - gap]);\n      start = p + gap;\n    });\n    spans.push([start, hi]);\n    return spans.filter((s) => s[1] - s[0] > gap * 10);\n  }\n\n  // Sample the fitted function into points, which is what a spline on the\n  // canvas is made of.\n  function sampleCurve(model, n) {\n    n = n || 60;\n    const out = [];\n    for (let i = 0; i <= n; i++) {\n      const x = model.lo + ((model.hi - model.lo) * i) / n;\n      const y = model.f(x);\n      if (Number.isFinite(y)) out.push([Math.round(x * 1000) / 1000, Math.round(y * 1000) / 1000]);\n    }\n    return out;\n  }\n\n  /* --- putting a curve onto a live canvas -------------------------------- */\n\n  // SketchResponse stores plugin state in SVG PIXEL coordinates, not graph\n  // coordinates. This is the same mapping the element's Python uses on the way\n  // in (sketchresponse.utils.graph_to_screen):\n  //     px = (value - start) * canvas_size / (end - start)\n  // with y inverted, because SVG y grows downward. config.xrange/yrange are\n  // already the padded ranges the server computed, so no margin maths here.\n  function graphToPixels(config, points) {\n    const x0 = config.xrange[0];\n    const x1 = config.xrange[1];\n    const y0 = config.yrange[0];\n    const y1 = config.yrange[1];\n    return points.map((p) => ({\n      x: ((p[0] - x0) * config.width) / (x1 - x0),\n      y: ((p[1] - y1) * config.height) / (y0 - y1),\n    }));\n  }\n\n  // Replace one tool's drawing with the given curve. A spline's state is an\n  // array of splines, each an array of control points, so we hand over a\n  // single spline. SketchResponse re-renders on setState.\n  function placeCurve(si, config, toolId, points) {\n    const state = JSON.parse(si.getState());\n    state.data[toolId] = [graphToPixels(config, points)];\n    si.setState(JSON.stringify(state));\n  }\n\n  // Which tool should receive the curve: the first editable curve-drawing tool\n  // in the toolbar.\n  function curveToolId(config) {\n    const plugins = (config && config.plugins) || [];\n    const curveTypes = ['spline', 'polyline', 'freeform'];\n    for (let i = 0; i < plugins.length; i++) {\n      const p = plugins[i];\n      if (curveTypes.indexOf(p.name) !== -1 && !p.readonly) return p.id;\n    }\n    return null;\n  }\n\n  const api = {\n    graphToPixels: graphToPixels,\n    placeCurve: placeCurve,\n    curveToolId: curveToolId,\n    fit: fit,\n    fitModel: fitModel,\n    autoSpec: autoSpec,\n    toPlFunction: toPlFunction,\n    splitDomainAtPoles: splitDomainAtPoles,\n    sampleCurve: sampleCurve,\n    FAM_LABEL: FAM_LABEL,\n  };\n\n  if (typeof module !== 'undefined' && module.exports) module.exports = api;\n  else root.StarFit = api;\n})(typeof window !== 'undefined' ? window : this);\n","pl-sketch.js":"// STAR: registry of l