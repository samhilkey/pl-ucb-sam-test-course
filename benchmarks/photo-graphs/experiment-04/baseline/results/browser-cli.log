              const count=Math.max(201,Math.min(1001,Math.ceil(length/2)));
              const points=[];
              for(let i=0;i<=count;i++){
                const p=path.getPointAtLength(length*i/count);
                points.push([p.x,p.y]);
              }
              return {d:path.getAttribute('d'),length,points};
            })
